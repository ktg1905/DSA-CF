#include <bits/stdc++.h>
using namespace std;
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int t;
    cin>>t;
    while(t--){
        int x, n;
        cin>>x>>n;
 
        int limit = x/n;
        int ans = 0;
        for(int i=1; i*i <= x; i++){
            if(x%i == 0){
                if(i<=limit){
                    ans = max(ans, i);
                }
 
                if(x/i <= limit){
                    ans = max(ans, x/i);
                }
            }
            
        }
        cout<<ans<<'
';
    }
 
    
 
    return 0;
}