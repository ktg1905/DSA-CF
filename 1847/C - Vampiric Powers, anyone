#include <bits/stdc++.h>
using namespace std;
using ll = long long;
 
struct Node{
    Node* child[2] = {NULL, NULL};
};
 
struct Trie{
    Node* root = new Node();
 
    void insert(int x){
        Node* cur = root;
 
        for(int i=7; i>=0; i--){
            int bit = (x>>i)&1;
 
            if(!cur->child[bit]){
                cur->child[bit] = new Node();
            }
 
            cur = cur->child[bit];
        }
    }
 
    int query(int x){
 
        Node* cur = root;
        int ans=0;
 
        for(int i=7; i>=0; i--){
            int bit = (x>>i)&1;
 
            if(cur->child[1-bit]){
                ans |= (1<<i);
                cur = cur->child[1-bit];
            }
            else{
                cur=cur->child[bit];
            }
        }
        return ans;
    }
};
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
 
        vector<int> a;
        for(int i=0; i<n; i++){
            int x;
            cin>>x;
            a.push_back(x);
        }
 
        vector<int> b(n+1, 0);
        for(int i=1; i<=n; i++){
            b[i] = b[i-1]^a[i-1];
        }
 
        Trie trie;
        trie.insert(b[0]);
 
        int ans=0;
 
        for(int i=1; i<=n; i++){
            ans = max(ans, trie.query(b[i]));
            trie.insert(b[i]);
        }
 
        cout<<ans<<'
';
 
    }
 
    return 0;
}