#include <bits/stdc++.h>
using namespace std;
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
 
        unordered_set<int> st;
 
        int flag=0;
        for(int i=0; i<n; i++){
            int x;
            cin>>x;
 
            if(st.find(x)!=st.end()){
                flag=1;
            }
            else{
                st.insert(x);
            }
        }
        if(flag==0){
            cout<<"no"<<'
';
        }
        else{
            cout<<"yes"<<'
';
        }
    }
 
    
 
    return 0;
}